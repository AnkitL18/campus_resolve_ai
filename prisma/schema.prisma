generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  STUDENT
  STAFF
  ADMIN
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REOPENED
  CLOSED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  rollNo       String?  @unique @map("roll_no") @db.VarChar(30)
  department   String?  @db.VarChar(100)
  role         UserRole @default(STUDENT)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  submittedTickets  Ticket[]      @relation("StudentTickets")
  assignedTickets   Ticket[]      @relation("AssignedTickets")
  managedCategories Category[]    @relation("CategoryOwner")
  createdEvents     TicketEvent[] @relation("EventCreator")

  @@map("users")
}

model Category {
  id                 Int     @id @default(autoincrement())
  name               String  @unique @db.VarChar(100)
  responsibleStaffId Int?    @map("responsible_staff_id")
  lowSlaHours        Int     @default(120) @map("low_sla_hours")
  mediumSlaHours     Int     @default(48) @map("medium_sla_hours")
  highSlaHours       Int     @default(6) @map("high_sla_hours")
  active             Boolean @default(true)

  responsibleStaff User?    @relation("CategoryOwner", fields: [responsibleStaffId], references: [id], onDelete: SetNull)
  tickets          Ticket[]

  @@index([responsibleStaffId])
  @@map("categories")
}

model Ticket {
  id               Int          @id @default(autoincrement())
  ticketCode       String       @unique @map("ticket_code") @db.VarChar(30)
  studentId        Int          @map("student_id")
  categoryId       Int          @map("category_id")
  assignedStaffId  Int?         @map("assigned_staff_id")
  description      String       @db.Text
  aiSummary        String?      @map("ai_summary") @db.VarChar(255)
  urgency          Urgency?
  status           TicketStatus @default(SUBMITTED)
  needsHumanReview Boolean      @default(false) @map("needs_human_review")
  reviewReason     String?      @map("review_reason") @db.VarChar(255)
  slaDeadline      DateTime?    @map("sla_deadline")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  student       User          @relation("StudentTickets", fields: [studentId], references: [id], onDelete: Restrict)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assignedStaff User?         @relation("AssignedTickets", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  events        TicketEvent[]

  @@index([studentId])
  @@index([categoryId])
  @@index([assignedStaffId])
  @@index([status])
  @@index([urgency])
  @@map("tickets")
}

model TicketEvent {
  id             Int           @id @default(autoincrement())
  ticketId       Int           @map("ticket_id")
  previousStatus TicketStatus? @map("previous_status")
  newStatus      TicketStatus  @map("new_status")
  note           String?       @db.Text
  createdById    Int?          @map("created_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([createdById])
  @@map("ticket_events")
}
